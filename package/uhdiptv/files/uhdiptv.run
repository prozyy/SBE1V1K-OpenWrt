#!/bin/sh
# Wrapper launched by procd as /usr/libexec/uhdiptv-run so that:
#   - the proxy runs inside its persistent working directory (it writes
#     device-state-rs.json / proxy-cache-state-rs.json into the CWD, and procd
#     has no chdir option);
#   - procd tags the captured stdout/stderr in syslog with this command's
#     basename ("uhdiptv-run"), so the lines are visible via `logread -e uhdiptv`.
# exec keeps the same PID, so procd's respawn/pidfile tracking still works.
cd "${UHDIPTV_WORKDIR:-/etc/uhdiptv}" 2>/dev/null || cd /tmp || exit 1
exec /usr/bin/uhdiptv "$@"
