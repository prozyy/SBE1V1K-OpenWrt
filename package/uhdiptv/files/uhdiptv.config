config uhdiptv 'main'
	option host '0.0.0.0'
	option port '8766'
	# Example playlist path shown in the LuCI subscription URL (channel selector).
	option playlist '4kfifa.m3u'
	option insecure_tls '0'
	# Optional tunables - leave empty to use the proxy's built-in defaults:
	option cache_ttl ''
	option http_workers ''
	option session_ttl ''
	option timeout ''
	option meta_json ''
	option device_json ''
	option extra_args ''
