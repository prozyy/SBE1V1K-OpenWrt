config uhdiptv 'main'
	option host '0.0.0.0'
	option port '8766'
	# Example playlist path shown in the LuCI subscription URL (channel selector).
	option playlist '4kfifa.m3u'
	# Directory for the proxy's state files (device-state-rs.json,
	# proxy-cache-state-rs.json); passed via --device-json/--meta-json.
	option data_dir '/etc/uhdiptv'
	option insecure_tls '0'
	# Optional tunables - leave empty to use the proxy's built-in defaults:
	option cache_ttl ''
	option http_workers ''
	option session_ttl ''
	option timeout ''
	option meta_json ''
	option device_json ''
	option extra_args ''
